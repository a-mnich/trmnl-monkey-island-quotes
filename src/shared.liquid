{% template session %}
<div class="layout">
  <div class="columns">
    <div class="column">
      <div class="richtext richtext--center">
        <div class="content content{{size_mod}}" data-content-limiter="true">
          <div class="text--center">
            {{ quote }}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% endtemplate %}

{% template title_bar %}
<div class="title_bar">
  <span class="title">{{ trmnl.plugin_settings.instance_name }}</span>
  <span class="instance">{{ instance }}</span>
</div>
{% endtemplate %}